{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDFnotator",
  "version": "../package.json",
  "identifier": "de.qaware.pdfnotator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PDFnotator",
        "width": 1200,
        "height": 900,
        "dragDropEnabled": true,
        "label": "main",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 22
        },
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "PDF viewer for pair-designing Typst documents with AI agents",
    "longDescription": "PDFnotator shows a Typst or PDF document next to your AI coding agent (GitHub Copilot, Claude Code, \u2026), reloads it seamlessly on every change and lets you send text comments, replacements, deletions and screenshot annotations straight to the agent via the Model Context Protocol.",
    "copyright": "\u00a9 2026 Thomas Oberbichler",
    "publisher": "Thomas Oberbichler",
    "license": "ISC",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "typ"
        ],
        "name": "Typst document",
        "description": "Typst source",
        "role": "Viewer",
        "mimeType": "text/x-typst"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF document",
        "description": "PDF document",
        "role": "Viewer",
        "mimeType": "application/pdf"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "section": "graphics"
      }
    }
  }
}
